---
import Base from '../../layouts/Base.astro';
import HoursTable from '../../components/HoursTable.astro';
import store from '../../data/store.json';
import '../../styles/shop.css';
import '../../styles/visit.css';

const a = store.address;
const L = store.links;
const [num, ...rest] = a.street.split(' ');
const road = rest.join(' ');
---
<Base footHours="link" footVisit={false} title="Hours and directions" description="Hours and directions for Mulligan Games, 445 York Road, Warminster, PA. House rules, what to bring, and a form to ask about stock or events.">
  <div class="wrap visit">
    <header class="page-head">
      <h1>Visit us</h1>
      <p class="page-lede">Stop in and stay for a game.</p>
    </header>

    <section class="band visit-band" id="find" aria-labelledby="find-h">
        <h2 id="find-h" class="vh">Address</h2>
        <address class="placard">
          <span class="placard-num" aria-hidden="true">{num}</span>
          <span class="vh">{num} </span><span class="placard-road">{road}</span>
          <span class="placard-town">{a.city}, {a.state} {a.zip}</span>
        </address>
        <p class="visit-actions"><a class="btn btn-wide" href={store.mapsUrl}>Open in Maps<span class="vh"> (Google Maps)</span></a></p>
        {(store.phone || store.email || L.discord) && (
          <ul class="reach">
            {store.phone && <li>Phone: <a href={`tel:${store.phone}`}>{store.phone}</a></li>}
            {store.email && <li>Email: <a href={`mailto:${store.email}`}>{store.email}</a></li>}
            {L.discord && <li>Discord: <a href={L.discord} rel="noopener">Join the server<span class="vh"> (opens another site)</span></a></li>}
          </ul>
        )}
      </section>

    <div class="visit-grid">
      <section class="box sheet-box" id="hours" aria-labelledby="hours-h">
        <span class="tape tape-l" aria-hidden="true"></span><span class="tape tape-r" aria-hidden="true"></span>
        <h2 id="hours-h">Hours</h2>
        <HoursTable />
      </section>

      <section class="box visit-form" id="contact" aria-labelledby="contact-h">
        <span class="tab">Contact</span>
        <h2 id="contact-h">Ask us something</h2>
        <p>Stock, events or your data. We reply by email.</p>
        <div class="form-msg ok" id="contact-ok" role="status" tabindex="-1" hidden>
          <h3><strong>Got it.</strong> Message sent.</h3>
          <p><a href="/events/">See this week</a></p>
        </div>
        <div class="form-msg error" id="contact-err" role="alert" tabindex="-1" hidden>
          <h3><strong>Error:</strong> that did not send.</h3>
          <p>Nothing was sent. Please check the fields and send it again, or ask at the counter.</p>
        </div>
        <form id="contact-form" method="post" action="/api/contact">
          <div class="field">
            <label for="c-name">Your name <span class="hint">(required)</span></label>
            <input type="text" id="c-name" name="name" required maxlength="80" autocomplete="name" />
          </div>
          <div class="field">
            <label for="c-email">Email <span class="hint">(required)</span></label>
            <input type="email" id="c-email" name="email" required maxlength="120" autocomplete="email" />
          </div>
          <div class="field">
            <label for="c-message">Message <span class="hint">(required)</span></label>
            <textarea id="c-message" name="message" required maxlength="1000" rows="3"></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="c-website">Leave this empty</label>
            <input type="text" id="c-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn" type="submit">Send my message</button>
        </form>
      </section>

      <aside class="sign sign-sky" id="play" aria-labelledby="play-h">
        <span class="tape tape-l" aria-hidden="true"></span><span class="tape tape-r" aria-hidden="true"></span>
        <h2 id="play-h">House rules</h2>
        <ul class="sign-list">
          <li>Be kind. Everyone is here for a good night.</li>
          <li>Ask before you touch someone else's cards.</li>
          <li>Clean up your table when you leave.</li>
          <li>Stay home if you are sick.</li>
          <li>Bring your deck, sleeves and dice. New to a game? Ask at the counter.</li>
        </ul>
        <p class="sign-note">Age rules and entry fees: confirm with the store.</p>
      </aside>
    </div>
  </div>
  <script is:inline slot="scripts" type="module" src="/js/visit-hours.js"></script>
  <script is:inline slot="scripts" type="module" src="/js/visit-contact.js"></script>
  <script is:inline slot="scripts" type="module" src="/js/form-check.js"></script>
</Base>
