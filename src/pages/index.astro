---
import Base from '../layouts/Base.astro';
import Turnstile from '../components/Turnstile.astro';
import BinderWeek from '../components/BinderWeek.astro';
import TonightStrip from '../components/TonightStrip.astro';
import TopReleases from '../components/TopReleases.astro';
import NewReleases from '../components/NewReleases.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import '../styles/sleeve.css';
import '../styles/home.css';
import '../styles/releases.css';

// Worker field values for /api/request (src/worker.js GAMES)
const requestGames = [['magic', 'Magic'], ['pokemon', 'Pokemon'], ['one-piece', 'One Piece'], ['riftbound', 'Riftbound'], ['hololive', 'Hololive'], ['tabletop', 'Warhammer and tabletop'], ['other', 'Something else']];
---
<Base title="Magic, Pokemon and One Piece nights" description="Local card and gaming shop at 445 York Road, Warminster, PA. Game nights, singles, sealed product and a buylist. Stop in and stay for a game.">
  <div class="wrap top-wrap"><TopReleases /></div>
  <div class="wrap home">
    <section class="hero box" aria-labelledby="hero-h">
      <h1 id="hero-h">Pull up a chair.</h1>
      <p class="hero-line">Singles and sealed product, with Commander, draft and more most nights. Stop in and stay for a game.</p>
      <p class="hero-cta">
        <a class="btn" href="/shop/">Find a card</a>
        <a class="btn btn-secondary" href="/events/">This week</a>
      </p>
      <div class="hand" aria-hidden="true"><i class="cback v0"></i><i class="cback v1"></i><i class="cback v0"></i></div>
    </section>

    <div class="home-tonight"><TonightStrip /></div>

    <section class="home-binder" aria-labelledby="binder-h">
      <h2 id="binder-h">Binder week</h2>
      <BinderWeek />
    </section>

    <NewReleases />

    <section class="box request" id="request" aria-labelledby="request-h">
      <span class="tab">Find a card</span>
      <h2 id="request-h">Not in the binder?</h2>
      <p>Send a want list and we will email you if it turns up.</p>
      <div class="form-msg ok" id="request-ok" role="status" tabindex="-1" hidden>
        <h3><strong>Got it.</strong> Want list sent.</h3>
        <p>We will email you back.</p>
        <p><a href="/shop/">Browse the shop</a></p>
      </div>
      <div class="form-msg error" id="request-err" role="alert" tabindex="-1" hidden>
        <h3><strong>Error:</strong> that did not send.</h3>
        <p>Nothing was sent. Please check the fields and send it again, or ask at the counter.</p>
      </div>
      <form id="request-form" method="post" action="/api/request" novalidate>
        <div class="field">
          <label for="req-cards">Cards you want <span class="hint">(required, one per line)</span></label>
          <textarea id="req-cards" name="cards" required maxlength="2000" rows="2"></textarea>
        </div>
        <div class="field">
          <label for="req-game">Game <span class="hint">(required)</span></label>
          <select id="req-game" name="game" required>
            {requestGames.map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="req-name">Your first name <span class="hint">(required)</span></label>
          <input type="text" id="req-name" name="name" required maxlength="80" autocomplete="given-name" />
        </div>
        <div class="field">
          <label for="req-email">Email <span class="hint">(required)</span></label>
          <input type="email" id="req-email" name="email" required maxlength="120" autocomplete="email" />
        </div>
        <div class="hp" aria-hidden="true">
          <label for="req-website">Leave this empty</label>
          <input type="text" id="req-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <Turnstile />
        <button class="btn" type="submit">Send my want list</button>
      </form>
    </section>

    <InstagramStrip />

    <section class="box sell" aria-labelledby="sell-h">
      <h2 id="sell-h">Sell to us</h2>
      <div class="slab">
        <span class="slab-name">Your cards</span>
        <span class="slab-cond">Cash or store credit</span>
        <span class="slab-id">Build a buylist, then bring the cards in. Rates are set at the counter.</span>
      </div>
      <p class="sell-cta"><a class="btn" href="/sell/">Build my buylist</a></p>
    </section>
  </div>
  <script is:inline slot="scripts" type="module" src="/js/home-live.js"></script>
  <script is:inline slot="scripts" type="module" src="/js/rel-tabs.js"></script>
  <script is:inline slot="scripts" type="module" src="/js/request-form.js"></script>
  <script is:inline slot="scripts" type="module" src="/js/form-check.js"></script>
</Base>
