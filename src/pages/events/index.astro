---
// Events: filter chips, weekly pairings sheet (by weekday), special nights, sign-up. Data: events.json, store.json, games.json.
// Weekdays, not dates, so "this week" is right on the day it is viewed without a rebuild; public/js/events.js adds today's date and marks tonight.
import Photo from "../../components/Photo.astro";
import Base from '../../layouts/Base.astro';
import events from '../../data/events.json';
import store from '../../data/store.json';
import games from '../../data/games.json';
import { DAYS, toWeek, fmtTime, byTime, zoned } from '../../lib/hours.js';
import { seedEvents } from '../../lib/seed-events.js';
import { gameId, isShown, isLikely, upcomingOneoffs, dateParts, signupLabel, upcomingSignup } from '../../lib/events.js';
import '../../styles/events.css';

const week = toWeek(store.hours);
// Same week order as Home's binder (Wed first, closed Mon/Tue last). public/js/events.js re-orders from today.
const order = [3, 4, 5, 6, 0, 1, 2];
const weekly = events.weekly.filter(isShown);
const days = order.map((d) => ({ d, name: DAYS[d], slug: DAYS[d].toLowerCase(), closed: !week[d], rows: weekly.filter((e) => e.day === d).sort(byTime) }));
const special = upcomingOneoffs(events.oneoffs, zoned(store.timezone).date);
// Sign-up nights: four weeks from the build date, same rows and ids as the D1 seed (tools/seed-events.mjs).
const nights = upcomingSignup(seedEvents(events.weekly, zoned(store.timezone).date), zoned(store.timezone).date);
const likely = [...weekly, ...special].some(isLikely);
const a = store.address;
// Chip ids from games.json; "other" is not a chip.
const chips = games.map((g) => ({ id: g.id, name: g.name }));
---
<Base title="Game nights and pairings" description="Weekly game nights in Warminster, PA: Magic, Pokemon, One Piece and more. Check the pairings sheet, special nights and fees, then hold a seat.">
  <div class="wrap ev">
    <header class="ev-head">
      <h1>Game nights</h1>
      <p class="ev-lead">Commander, draft FNM and more. Find your night, then hold a seat.</p>
    </header>

    <div class="ev-layout">
      <nav class="ev-filter" aria-label="Filter by game">
        <h2 class="label">Game</h2>
        <ul class="chips">
          <li><a class="chip chip-filter" href="/events/" data-filter="all" aria-current="page">All</a></li>
          {chips.map((c) => <li><a class="chip chip-filter" href={`/events/?game=${c.id}`} data-filter={c.id}>{c.name}</a></li>)}
        </ul>
      </nav>

      <div class="ev-main">
        <section class="sheet-wrap" aria-labelledby="sheet-h">
          <h2 id="sheet-h">Pairings sheet</h2>
          <p class="ev-none" id="ev-none" role="status" hidden></p>
          <div class="sheet">
            <span class="tape tape-l" aria-hidden="true"></span><span class="tape tape-r" aria-hidden="true"></span>
            <div class="sheet-head mono" aria-hidden="true"><span>Time</span><span>Game</span><span>Format</span><span>Fee</span><span>Seat</span></div>
            {days.map((x) => (
              <section class="day" id={x.slug} aria-labelledby={`h-${x.slug}`} data-day={x.d} data-closed={x.closed ? '' : undefined}>
                <h3 id={`h-${x.slug}`}>{x.name} <span class="day-date mono" data-day-date hidden></span>{x.closed && <span class="day-closed">· Closed</span>}</h3>
                {x.closed ? null : x.rows.length === 0 ? (
                  <p class="day-note">Nothing booked yet.</p>
                ) : (
                  <>
                    <table class="pairings" role="table">
                      <caption class="vh">{x.name} game nights</caption>
                      <colgroup aria-hidden="true"><col /><col /><col /><col /><col /></colgroup>
                      <thead role="rowgroup" class="vh">
                        <tr role="row"><th scope="col" role="columnheader">Time</th><th scope="col" role="columnheader">Game</th><th scope="col" role="columnheader">Format</th><th scope="col" role="columnheader">Fee</th><th scope="col" role="columnheader">Seat</th></tr>
                      </thead>
                      <tbody role="rowgroup">
                        {x.rows.map((e) => (
                          <tr role="row" data-game={gameId(e.game)}>
                            <td role="cell" data-label="Time"><span class="mono">{fmtTime(e.time)}</span></td>
                            <td role="cell" data-label="Game">{e.game}</td>
                            <th scope="row" role="rowheader" data-label="Format">{e.format}{e.cap !== null && <span class="cap"> {e.cap} seats</span>}</th>
                            <td role="cell" data-label="Fee">{e.fee !== null && <span class="sticker">${e.fee}</span>}</td>
                                                        <td role="cell" data-label="Seat" class="row-act"><div class="act">
                              {e.cap !== null && <a class="btn btn-secondary btn-sm" href="#signup">Hold a seat<span class="vh"> for {e.format}, {x.name}</span></a>}
                              <a class="cal" href={`/events/${e.id}.ics`}>Add to calendar<span class="vh">: {e.format}, {x.name}</span></a></div>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    <p class="day-note day-none" hidden>No nights for this game on {x.name}.</p>
                  </>
                )}
              </section>
            ))}
          </div>
          {likely && <p class="ev-note">Nights and fees come from public listings. Confirm with the store.</p>}
        </section>

      </div>
      <div class="ev-side">
          <section class="special" id="special" aria-labelledby="special-h">
            <h2 id="special-h">Special nights</h2>
            <p class="ev-none" id="special-none" hidden>No special nights on the calendar yet.</p>
            {special.length === 0 ? <p>No special nights on the calendar yet.</p> : (
              <ul class="tickets">
                {special.map((e) => {
                  const p = dateParts(e.date);
                  return (
                    <li class="ticket" data-game={gameId(e.game)} data-date={e.date}>
                      <time class="stub" datetime={e.date}><span>{p.dow}</span><b>{p.dom}</b><span>{p.mon}</span></time>
                      <div class="ticket-body">
                        <h3>{e.title}</h3>
                        <p class="muted">{e.game} · <span class="mono">{fmtTime(e.time)}</span> · {a.street}</p>
                        <p class="ticket-act">
                          {e.fee !== null && <span class="sticker">${e.fee}</span>}
                          {e.cap !== null
                            ? <a class="btn btn-secondary" href="#signup">Hold a seat<span class="vh"> for {e.title}</span></a>
                            : <a class="btn btn-ghost" href={`/events/${e.id}.ics`}>Add to calendar<span class="vh">: {e.title}</span></a>}
                        </p>
                      </div>
                    </li>
                  );
                })}
              </ul>
            )}
          </section>
      <section class="signup" id="signup" aria-labelledby="signup-h">
        <span class="clip" aria-hidden="true"></span>
        <div class="paper">
        <p class="sheet-label mono">Sign-up sheet</p>
        <h2 id="signup-h">Hold a seat</h2>
        <p>Pick a night, add your first name and email. Under 13? Bring a grown-up (confirm with the store).</p>
  
        <div class="form-msg ok" id="signup-ok" role="status" tabindex="-1" hidden>
          <h3><strong>Got it.</strong> Seat held.</h3>
          <p>We have your name and email for that night. See you at the table.</p>
          <p><a href="/events/">Back to game nights</a></p>
        </div>
        <div class="form-msg ok" id="signup-wait" role="status" tabindex="-1" hidden>
          <h3><strong>You are on the waitlist.</strong> That night is full.</h3>
          <p><a href="/events/">Pick another night</a> or ask at the counter.</p>
        </div>
        <div class="form-msg error" id="signup-err" role="alert" tabindex="-1" hidden>
          <h3 id="signup-err-h"><strong>Error:</strong> that did not send.</h3>
          <ul id="signup-err-list"></ul>
          <p id="signup-err-server">Nothing was sent. Check the night, name and email and send it again. Already held that seat? You are on the list.</p>
        </div>
  
        <p class="signup-empty" id="signup-empty" role="status" hidden={nights.length > 0}>Sign-ups for the next nights open soon. Just turn up, or ask at the counter.</p>
  
        <form id="signup-form" method="post" action="/api/signup" novalidate hidden={nights.length === 0}>
          <div class="field">
            <label for="su-event">Night <span class="hint">(required)</span></label>
            <select id="su-event" name="event_id" required>
              {nights.map((e) => <option value={e.id} data-date={e.date}>{signupLabel(e)}</option>)}
            </select>
            <p class="hint seats" id="su-seats" aria-live="polite">Seats: ask at the counter</p>
          </div>
          <div class="field">
            <label for="su-name">Your first name <span class="hint">(required)</span></label>
            <input type="text" id="su-name" name="name" required maxlength="80" autocomplete="given-name" />
          </div>
          <div class="field">
            <label for="su-email">Email <span class="hint">(required)</span></label>
            <input type="email" id="su-email" name="email" required maxlength="120" autocomplete="email" />
          </div>
          <div class="field">
            <label for="su-note">Anything we should know <span class="hint">(optional, 200 characters)</span></label>
            <input type="text" id="su-note" name="players_note" maxlength="200" />
          </div>
          <div class="hp" aria-hidden="true">
            <label for="su-website">Leave this empty</label>
            <input type="text" id="su-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn" type="submit">Hold my seat</button>
        </form>
        </div>
      </section>
      <p class="ev-ask">Want a night we do not list? <a href="/visit/#contact">Ask us</a></p>
      <Photo class="ev-photo" photo={store.photos.playRoom} label="the play room" />
        </div>
    </div>
  </div>
  <script is:inline slot="scripts" type="module" src="/js/events.js"></script>
</Base>
