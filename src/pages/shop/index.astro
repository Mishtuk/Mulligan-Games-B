---
import Base from '../../layouts/Base.astro';
import Pocket from '../../components/Pocket.astro';
import ConditionGuide from '../../components/ConditionGuide.astro';
import Toploader from '../../components/Toploader.astro';
import games from '../../data/games.json';
import products from '../../data/products.json';
import '../../styles/shop.css';

// Worker field values for /api/request (src/worker.js GAMES)
const requestGames = [['magic', 'Magic'], ['pokemon', 'Pokemon'], ['one-piece', 'One Piece'], ['riftbound', 'Riftbound'], ['hololive', 'Hololive'], ['tabletop', 'Warhammer or tabletop'], ['other', 'Something else']];
const sealed = products.filter((p) => p.kind !== 'preorder');
const preorders = products.filter((p) => p.kind === 'preorder');
const price = (n: number | null) => (n === null || n === undefined ? 'Ask in store' : `$${n}`);
---
<Base title="Shop singles, sealed and preorders" description="Singles, sealed product and preorders at Mulligan Games in Warminster, PA. Send a want list, check our condition guide, and ask in store for stock and prices.">
  <div class="wrap shop">
    <header class="page-head">
      <h1>Shop</h1>
      <p class="page-lede">Singles, sealed product and preorders. Stock changes daily, so ask at the counter or send a request.</p>
      <nav class="shop-jump" aria-label="Shop sections">
        <a class="chip" href="#singles">Singles</a>
        <a class="chip" href="#sealed">Sealed</a>
        <a class="chip" href="#preorders">Preorders</a>
      </nav>
    </header>

    <section class="box" id="singles" aria-labelledby="singles-h">
      <span class="tab">01 / Singles</span>
      <h2 id="singles-h">Singles</h2>
      <div class="singles-grid">
        <div class="request" id="request">
          <h3>Looking for a card?</h3>
          <p>No online catalog yet. Send a want list and we will message you if we find it. Add set, condition and how many on the same line if it matters.</p>
          <div class="form-msg ok" id="request-ok" role="status" tabindex="-1" hidden>
            <h3><strong>Got it.</strong> Request sent.</h3>
            <p>We will message you if we find it. Nothing else is sent to you.</p>
            <p><a href="/events/">See this week's events</a></p>
          </div>
          <div class="form-msg error" id="request-err" role="alert" tabindex="-1" hidden>
            <h3><strong>Error:</strong> that did not send.</h3>
            <p>Check each field and try again, or ask at the counter.</p>
          </div>
          <form id="request-form" method="post" action="/api/request" novalidate>
            <div class="field">
              <label for="req-cards">Card or cards you want <span class="hint">(required, one per line, up to 50)</span></label>
              <textarea id="req-cards" name="cards" required maxlength="2000" rows="4"></textarea>
            </div>
            <div class="field">
              <label for="req-game">Game <span class="hint">(required)</span></label>
              <select id="req-game" name="game" required>
                {requestGames.map(([v, l]) => <option value={v}>{l}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="req-name">Your first name <span class="hint">(required)</span></label>
              <input type="text" id="req-name" name="name" required maxlength="80" autocomplete="given-name" />
            </div>
            <div class="field">
              <label for="req-email">Email to reach you <span class="hint">(required)</span></label>
              <input type="email" id="req-email" name="email" required maxlength="120" autocomplete="email" />
            </div>
            <div class="hp" aria-hidden="true">
              <label for="req-website">Leave this empty</label>
              <input type="text" id="req-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <button class="btn" type="submit">Send request</button>
          </form>
        </div>
        <Toploader />
      </div>

      <h3 class="sub" id="condition">Condition guide</h3>
      <p>How we describe a card. The same words are used when you sell to us.</p>
      <ConditionGuide />
    </section>

    <section class="box box-sky" id="sealed" aria-labelledby="sealed-h">
      <span class="tab">02 / Sealed</span>
      <h2 id="sealed-h">Sealed product</h2>
      <p>Boxes, decks and more. Prices and stock: ask in store.</p>
      <ul class="shop-grid">
        {sealed.length ? sealed.map((p) => (
          <Pocket href="/visit/#contact" title={p.name} variant="sealed">
            <Fragment slot="art"><div class="box-sil" aria-hidden="true"></div></Fragment>
            <p>{p.game}</p>
            <Fragment slot="foot"><span class="sticker">{price(p.price)}</span></Fragment>
          </Pocket>
        )) : games.map((g) => (
          <Pocket href="/visit/#contact" title={g.name} variant="sealed">
            <Fragment slot="art"><div class="box-sil" aria-hidden="true"></div></Fragment>
            <p>Sealed {g.name} product.</p>
            <Fragment slot="foot"><span class="chip">Ask in store</span></Fragment>
          </Pocket>
        ))}
      </ul>
      <p class="empty-line">Stock changes daily. Ask at the counter or send a request.</p>
    </section>

    <section class="box" id="preorders" aria-labelledby="preorders-h">
      <span class="tab">03 / Preorders</span>
      <h2 id="preorders-h">Preorders</h2>
      <p>Release dates and deposits: ask in store.</p>
      <ul class="shop-grid">
        {preorders.length ? preorders.map((p) => (
          <Pocket href="/visit/#contact" title={p.name} variant="preorder">
            <Fragment slot="art"><div class="box-sil" aria-hidden="true"></div></Fragment>
            <p>{p.game}</p>
            <Fragment slot="foot">{p.releaseDate && <span class="mono">{p.releaseDate}</span>}<span class="sticker">{price(p.price)}</span></Fragment>
          </Pocket>
        )) : games.map((g) => (
          <Pocket href="/visit/#contact" title={g.name} variant="preorder">
            <Fragment slot="art"><div class="box-sil" aria-hidden="true"></div></Fragment>
            <p>Upcoming {g.name} releases.</p>
            <Fragment slot="foot"><span class="mono">Date: ask</span><span class="chip">Deposit: ask in store</span></Fragment>
          </Pocket>
        ))}
      </ul>
    </section>
  </div>
  <script is:inline slot="scripts" src="/js/request-form.js" defer></script>
</Base>
