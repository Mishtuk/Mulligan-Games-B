---
import Base from '../../layouts/Base.astro';
import Pocket from '../../components/Pocket.astro';
import ConditionGuide from '../../components/ConditionGuide.astro';
import games from '../../data/games.json';
import products from '../../data/products.json';
import { splitProducts, joinNames } from '../../lib/shop.js';
import '../../styles/shop.css';

// Worker field values for /api/request (src/worker.js GAMES)
const requestGames = [['magic', 'Magic'], ['pokemon', 'Pokemon'], ['one-piece', 'One Piece'], ['riftbound', 'Riftbound'], ['hololive', 'Hololive'], ['tabletop', 'Warhammer or tabletop'], ['other', 'Something else']];
const { sealed, preorders } = splitProducts(products);
const gameNames = joinNames(games);
const price = (n: number | null) => (n === null || n === undefined ? 'Ask in store' : `$${n}`);
---
<Base title="Singles, sealed and preorders" description="Singles, sealed product and preorders for Magic, Pokemon, One Piece and more in Warminster, PA. Send a want list or ask at the counter.">
  <div class="wrap shop">
    <header class="page-head">
      <h1>Shop</h1>
      <p class="page-lede">Stock moves daily. Ask at the counter or send a want list.</p>
      <nav class="shop-jump" aria-label="Shop sections">
        <a class="chip" href="#singles">Singles</a>
        <a class="chip" href="#sealed">Sealed</a>
        <a class="chip" href="#preorders">Preorders</a>
      </nav>
    </header>

    <section class="box" id="singles" aria-labelledby="singles-h">
      <h2 id="singles-h">Singles</h2>
      <div class="singles-grid">
        <div class="request" id="request">
          <h3>Want list</h3>
          <p>No online catalog yet. Tell us what you are after and we will email you if it turns up.</p>
          <div class="form-msg ok" id="request-ok" role="status" tabindex="-1" hidden>
            <h3><strong>Got it.</strong> Want list sent.</h3>
            <p>We will email you if it turns up. Nothing else gets sent.</p>
            <p><a href="/events/">See this week</a></p>
          </div>
          <div class="form-msg error" id="request-err" role="alert" tabindex="-1" hidden>
            <h3><strong>Error:</strong> that did not send.</h3>
            <p>Check each field and try again, or ask at the counter.</p>
          </div>
          <form id="request-form" method="post" action="/api/request" novalidate>
            <div class="field">
              <label for="req-cards">Card or cards you want <span class="hint">(required, up to 50 lines)</span></label>
              <p class="example" id="req-cards-ex">One card per line: name, set, condition, how many. Example: <span class="mono-ex">Sol Ring, Commander Masters, NM, 1</span></p>
              <textarea id="req-cards" name="cards" required maxlength="2000" rows="6" aria-describedby="req-cards-ex"></textarea>
            </div>
            <div class="field">
              <label for="req-game">Game <span class="hint">(required)</span></label>
              <select id="req-game" name="game" required>
                {requestGames.map(([v, l]) => <option value={v}>{l}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="req-name">Your first name <span class="hint">(required)</span></label>
              <input type="text" id="req-name" name="name" required maxlength="80" autocomplete="given-name" />
            </div>
            <div class="field">
              <label for="req-email">Email to reach you <span class="hint">(required)</span></label>
              <input type="email" id="req-email" name="email" required maxlength="120" autocomplete="email" />
            </div>
            <div class="hp" aria-hidden="true">
              <label for="req-website">Leave this empty</label>
              <input type="text" id="req-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <button class="btn" type="submit">Send my want list</button>
          </form>
        </div>
      </div>

      <h3 class="sub" id="condition">Condition guide</h3>
      <p>Same grades whether you buy or sell.</p>
      <ConditionGuide />
    </section>

    <section class="band band-crimp" id="sealed" aria-labelledby="sealed-h">
      <h2 id="sealed-h">Sealed product</h2>
      {sealed.length ? (
        <ul class="shop-grid">
          {sealed.map((p) => (
            <Pocket href="/visit/#contact" title={p.name} variant="sealed">
              <Fragment slot="art"><div class="box-sil" aria-hidden="true"></div></Fragment>
              <p>{p.game}</p>
              <Fragment slot="foot"><span class="sticker">{price(p.price)}</span></Fragment>
            </Pocket>
          ))}
        </ul>
      ) : (
        <div class="shelf">
          <h3>On the shelf</h3>
          <p>We carry {gameNames}. Ask what is in.</p>
          <a class="btn" href="/visit/#contact">Ask about stock</a>
        </div>
      )}
    </section>

    <section class="airy" id="preorders" aria-labelledby="preorders-h">
      <h2 id="preorders-h">Preorders</h2>
      {preorders.length ? (
        <ul class="shop-grid">
          {preorders.map((p) => (
            <Pocket href="/visit/#contact" title={p.name} variant="preorder">
              <Fragment slot="art"><div class="box-sil is-pack" aria-hidden="true"></div></Fragment>
              <p>{p.game}</p>
              <Fragment slot="foot">{p.releaseDate && <span class="mono">{p.releaseDate}</span>}<span class="sticker">{price(p.price)}</span></Fragment>
            </Pocket>
          ))}
        </ul>
      ) : (
        <p>Nothing listed yet. <a href="/visit/#contact">Ask us</a> what is coming and when.</p>
      )}
    </section>
  </div>
  <script is:inline slot="scripts" src="/js/request-form.js" defer></script>
  <script is:inline slot="scripts" type="module" src="/js/form-check.js"></script>
</Base>
