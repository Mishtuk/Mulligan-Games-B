---
import Base from '../../layouts/Base.astro';
import Turnstile from '../../components/Turnstile.astro';
import Pocket from '../../components/Pocket.astro';
import ConditionGuide from '../../components/ConditionGuide.astro';
import all from '../../data/releases.json';
import store from '../../data/store.json';
import { zoned } from '../../lib/hours.js';
import { shownReleases, dateLine, isOut } from '../../lib/releases.js';
import { holdHref, holdLine } from '../../lib/shop.js';
const srcset = (i) => i.webp.map(([u, w]) => `${u} ${w}w`).join(', ');
import '../../styles/shared.css';
import '../../styles/sleeve.css';
import '../../styles/shop-only.css';

// Worker field values for /api/request (src/worker.js GAMES)
const requestGames = [['magic', 'Magic'], ['pokemon', 'Pokemon'], ['one-piece', 'One Piece'], ['riftbound', 'Riftbound'], ['hololive', 'Hololive'], ['tabletop', 'Warhammer and tabletop'], ['other', 'Something else']];
// Same rows as Home's New releases: confirmed sets only. Out now = Sealed, coming = Preorders.
const today = zoned(store.timezone).date;
const rows = shownReleases(all.filter((r) => r.certainty === 'Confirmed'), today);
const out = rows.filter((r) => isOut(r.releaseDate, today)), soon = rows.filter((r) => !isOut(r.releaseDate, today));
const shelfGames = [[''], ['g-pokemon', 'g-one-piece', 'g-riftbound']];
const shelfTags = ["Magic · Commander staples", "Pokemon · One Piece · Riftbound"];
---
<Base title="Singles, sealed and preorders" description="Singles, sealed product and preorders for Magic, Pokemon, One Piece and more in Warminster, PA. Send a want list or ask at the counter.">
  <div class="wrap shop">
    <header class="page-head">
      <h1>Shop</h1>
      <p class="page-lede">Not here? Send a want list.</p>
      <nav class="shop-jump" aria-label="Shop sections">
        <a class="chip" href="#singles">Singles</a>
        <a class="chip" href="#sealed">Sealed</a>
        <a class="chip" href="#preorders">Preorders</a>
      </nav>
    </header>

    <section class="airy" id="singles" aria-labelledby="singles-h">
      <h2 id="singles-h">Singles</h2>
      <p class="muted case-note">Singles by game. Ask at the counter for a price.</p>
      <div class="case">
        {[0, 1].map((r) => (
          <div class="case-shelf">
            <p class="shelf-tag">{shelfTags[r]}</p>
            <div class="slots" aria-hidden="true">
            {Array.from({ length: 8 }, (_, i) => (
              <span class={`slot${(i + r * 3) % 4 === 1 ? ' is-top' : ''}`}><i class={`cback ${shelfGames[r][i % shelfGames[r].length]}`}></i></span>
            ))}
            </div>
          </div>
        ))}
      </div>
      <ConditionGuide />
    </section>

    <section class="box request" id="request" aria-labelledby="request-h">
      <h2 id="request-h">Not in the case? Ask for it.</h2>
      <p>No online catalog yet. Send a want list and we will email you if it turns up.</p>
      {rows.map((r) => <p class="hold-line" id={`hold-${r.id}`}>Holding {r.name}? Write "Hold: {r.name}" in the cards box below.</p>)}
      {all.filter((r) => !rows.includes(r)).map((r) => <p class="hold-line" id={`hold-${r.id}`}>Write the set you want held in the cards box below.</p>)}
      <p class="hold-note" id="req-hold" role="status" hidden></p>
      <div class="form-msg ok" id="request-ok" role="status" tabindex="-1" hidden>
        <h3><strong>Got it.</strong> Want list sent.</h3>
        <p>We will email you back. Nothing else gets sent to you.</p>
        <p><a href="/events/">See this week</a></p>
      </div>
      <div class="form-msg error" id="request-err" role="alert" tabindex="-1" hidden>
        <h3><strong>Error:</strong> that did not send.</h3>
        <p>Nothing was sent. Please check the fields and send it again, or ask at the counter.</p>
      </div>
      <form id="request-form" method="post" action="/api/request" novalidate>
        <div class="field">
          <label for="req-cards">Cards you want <span class="hint">(required, up to 50 lines)</span></label>
          <p class="example" id="req-cards-ex">One card per line: name, set, condition, how many. Example: <span class="mono-ex">Sol Ring, Commander Masters, NM, 1</span></p>
          <textarea id="req-cards" name="cards" required maxlength="2000" rows="6" aria-describedby="req-cards-ex"></textarea>
        </div>
        <div class="field">
          <label for="req-game">Game <span class="hint">(required)</span></label>
          <select id="req-game" name="game" required>
            {requestGames.map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="req-name">Your first name <span class="hint">(required)</span></label>
          <input type="text" id="req-name" name="name" required maxlength="80" autocomplete="given-name" />
        </div>
        <div class="field">
          <label for="req-email">Email <span class="hint">(required)</span></label>
          <input type="email" id="req-email" name="email" required maxlength="120" autocomplete="email" />
        </div>
        <div class="hp" aria-hidden="true">
          <label for="req-website">Leave this empty</label>
          <input type="text" id="req-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <Turnstile />
        <button class="btn" type="submit">Send my want list</button>
      </form>
    </section>

    <section class="band" id="stock" aria-label="Sealed and preorders">
      <div class="stock">
        {[['sealed', 'Sealed', out, 'Nothing out yet. Ask at the counter.'], ['preorders', 'Preorders', soon, 'Nothing announced yet. Ask at the counter.']].map(([id, h, list, none]) => (
          <section id={id} aria-labelledby={`${id}-h`}>
            <h2 id={`${id}-h`}>{h}</h2>
            {list.length ? (
              <ul class="shop-grid">
                {list.map((r) => (
                  <Pocket href={holdHref(r.id)} title={r.name} variant={id === 'sealed' ? 'sealed' : 'preorder'}>
                    <Fragment slot="art">{r.product ? (<div class="box-shot"><picture><source type="image/webp" srcset={srcset(r.product)} sizes="(min-width: 1000px) 15rem, 40vw" /><img src={r.product.jpg} width={r.product.width} height={r.product.height} alt={r.product.alt} loading="lazy" /></picture></div>) : (<div class={`box-sil${id === 'sealed' ? '' : ' is-pack'}`} aria-hidden="true"></div>)}</Fragment>
                    <p>{r.game}</p>{r.product && <p class="credit">{r.product.credit}</p>}
                    <Fragment slot="foot"><span class="mono">{dateLine(r.releaseDate, today)}</span><a class="btn hold" href={holdHref(r.id)} data-hold={r.id} data-name={r.name} data-game={r.gameId} data-line={holdLine(r, id === 'sealed')}>Hold one for me<span class="vh">, {r.name}</span></a></Fragment>
                  </Pocket>
                ))}
              </ul>
            ) : (<p>{none}</p>)}
          </section>
        ))}
      </div>
    </section>
  </div>
  <script is:inline slot="scripts" type="module" src="/js/request-form.js"></script>
  <script is:inline slot="scripts" type="module" src="/js/hold.js"></script>
  <script is:inline slot="scripts" type="module" src="/js/form-check.js"></script>
</Base>
