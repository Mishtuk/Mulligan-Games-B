---
import '../styles/global.css';
import store from '../data/store.json';
import OpenChip from '../components/OpenChip.astro';
import { DAYS, toWeek, hoursText } from '../lib/hours.js';
import { SITE_URL, LOGO } from '../lib/site.js';

interface Props { title: string; description: string; noindex?: boolean; exactTitle?: boolean; footHours?: 'full' | 'link'; footVisit?: boolean; }
// footVisit=false: the page already shows the address, Maps link and contacts, so the footer drops its Visit us column.
// footHours='link': the page already shows the hours table, so the footer points to it instead of repeating it.
const { title, description, noindex = false, exactTitle = false, footHours = 'full', footVisit = true } = Astro.props;
const fullTitle = exactTitle ? title : `${title} | Mulligan Games, Warminster PA`; // exactTitle: product pages carry the writer's whole title
const path = Astro.url.pathname;
const canonical = SITE_URL + path;
const logoUrl = SITE_URL + LOGO.path;
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const navDesk = [['Events', '/events/'], ['Shop', '/shop/'], ['Sell to us', '/sell/'], ['Visit', '/visit/']];
const navSheet = [['Events', '/events/'], ['Shop', '/shop/'], ['Visit', '/visit/'], ['Sell to us', '/sell/'], ['Home', '/']];

const week = toWeek(store.hours);
const order = [1, 2, 3, 4, 5, 6, 0];
const a = store.address;
const L = store.links;
const links = [
  L.instagram && ['Instagram', L.instagram], L.x && ['X', L.x], L.patreon && ['Patreon', L.patreon],
  L.topdeck && ['TopDeck', L.topdeck], L.wizardsLocator && ['Wizards store locator', L.wizardsLocator],
  L.discord && ['Discord', L.discord], L.tiktok && ['TikTok', L.tiktok],
].filter(Boolean) as string[][];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: store.name,
  description,
  address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.city, addressRegion: a.state, postalCode: a.zip, addressCountry: 'US' },
  url: SITE_URL + '/',
  image: logoUrl,
  hasMap: store.mapsUrl,
  openingHoursSpecification: order.filter((d) => week[d]).map((d) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: DAYS[d], opens: week[d]!.open, closes: week[d]!.close === '24:00' ? '23:59' : week[d]!.close })),
  ...(store.phone ? { telephone: store.phone } : {}),
  sameAs: links.map((l) => l[1]).filter((u) => u !== L.wizardsLocator),
};
const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c');
const hoursData = JSON.stringify({ tz: store.timezone, hours: store.hours });
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#120B1E" />
    <script is:inline src="/js/theme-init.js"></script>
    <script is:inline src="/js/motion-boot.js"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={store.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={logoUrl} />
    <meta property="og:image:width" content={String(LOGO.width)} />
    <meta property="og:image:height" content={String(LOGO.height)} />
    <meta property="og:image:alt" content="Mulligan Games logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/img/logo/apple-touch-180.png" />
    <link rel="preload" href="/fonts/titan-one-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={ldJson}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="btn skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header-in">
        <a class="brand" href="/"><img src="/img/logo/mulligan-games-340.png" width="340" height="120" alt="Mulligan Games, home" /></a>
        <nav class="nav-desk" aria-label="Main">
          {navDesk.map(([label, href]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <OpenChip class="header-chip" />
        <button type="button" id="menu-btn" aria-expanded="false" aria-controls="menu-sheet">Menu</button>
      </div>
      <nav class="menu-sheet" id="menu-sheet" aria-label="Menu">
        {navSheet.map(([label, href]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <div class="chip-strip"><div class="wrap"><OpenChip /></div></div>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          {footVisit && <div>
            <h2>Visit us</h2>
            <address>{a.street}<br />{a.city}, {a.state} {a.zip}</address>
            <p><a href={store.mapsUrl}>Open in Maps<span class="vh"> (Google Maps)</span></a></p>
            {store.phone && <p><a href={`tel:${store.phone}`}>{store.phone}</a></p>}
            {store.email && <p><a href={`mailto:${store.email}`}>{store.email}</a></p>}
          </div>}
          {footHours !== 'link' && <div>
              <>
                <h2>Hours</h2>
                <dl class="hours">
                  {order.map((d) => (
                    <div data-day={d}><dt>{DAYS[d]}</dt><dd>{hoursText(week[d])}</dd></div>
                  ))}
                </dl>
                <p class="foot-note">Hours and nights can change. Confirm with the store.</p>
              </>
          </div>}
          <nav aria-label="Footer: find us online">
            <h2>Find us online</h2>
            <ul class="foot-links">
              {links.map(([label, href]) => <li><a href={href} rel="noopener">{label}<span class="vh"> (opens another site)</span></a></li>)}
              <li><a href="/privacy/">Privacy</a></li>
            </ul>
          </nav>
        </div>
        <p class="foot-legal">Not affiliated with Wizards of the Coast, The Pokémon Company, Bandai or any publisher. Game names and set images belong to their publishers.</p>
      </div>
    </footer>
    <button type="button" class="theme-toggle" aria-label="Switch to light mode" title="Switch to light mode">
      <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg>
      <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z" /></svg>
    </button>
    <script type="application/json" id="hours-data" set:html={hoursData}></script>
    <script is:inline src="/js/site.js" defer></script>
    <script is:inline type="module" src="/js/open-chip.js"></script>
    <script is:inline type="module" src="/js/today.js"></script>
    <slot name="scripts" />
  </body>
</html>
