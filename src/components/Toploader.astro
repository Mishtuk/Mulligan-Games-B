---
// Featured single in a toploader: heavy frame, notch, CSS card-back placeholder (no invented card), slab label below.
import Slab from './Slab.astro';
---
<figure class="toploader">
  <div class="tl-frame">
    <div class="tl-notch" aria-hidden="true"></div>
    <div class="tl-card" role="img" aria-label="Photo coming: featured single">
      <span>Photo coming</span>
    </div>
  </div>
  <figcaption><Slab name="Featured single" cond="TBD" id="Pick not set yet. Ask in store." /></figcaption>
</figure>
