---
// "From our Instagram": promo text from instagram.json, one click-to-load facade per post (CONTEXT rule 13). No Instagram request until a tap.
import posts from '../data/instagram.json';
import store from '../data/store.json';
const ok = posts.filter((p) => /^[\w-]{6,20}$/.test(p.code));
---
{ok.length > 0 && (
<section class="home-ig" aria-labelledby="ig-h">
  <h2 id="ig-h">From our Instagram</h2>
  <ul class="ig-grid">
    {ok.map((p) => (
      <li class="ig-card">
        <h3>{p.title}</h3>
        {p.lines.map((l) => <p>{l}</p>)}
        {p.note && <p class="muted">{p.note}</p>}
        <div class="ig-slot"><a class="btn btn-secondary" href={`https://www.instagram.com/p/${p.code}/`} data-ig={p.code} data-title={p.title} rel="noopener">Show this post from Instagram</a></div>
      </li>
    ))}
  </ul>
  <p><a class="btn btn-ghost" href={store.links.instagram} rel="noopener">Follow @mulligangames<span class="vh"> (opens Instagram)</span></a></p>
</section>
)}
