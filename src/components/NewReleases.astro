---
// New releases: official publisher images (CONTEXT rule 12), status computed at build and again in public/js/home-live.js (store zone).
import all from '../data/releases.json';
import store from '../data/store.json';
import { zoned } from '../lib/hours.js';
import { holdHref } from '../lib/shop.js';
import { shownReleases, releaseLabel, dateLine } from '../lib/releases.js';

const today = zoned(store.timezone, process.env.SITE_NOW ? new Date(process.env.SITE_NOW) : undefined).date; // SITE_NOW: fixed-date build check
const rows = shownReleases(all.filter((r) => /^Confirmed/.test(r.certainty)), today);
// Star Trek leads while it is under 90 days old (shownReleases order). One list feeds the carousel and the grid: slide ids are slide-<id>, grid ids rel-<id>.
const GRID = '(min-width: 1200px) 211px, (min-width: 960px) 17vw, calc(50vw - 2rem)';
const SLIDE = '(min-width: 960px) 616px, (min-width: 720px) 55vw, calc(100vw - 2rem)';
const srcset = (i) => i.webp.map(([u, w]) => `${u} ${w}w`).join(', ');
---
{rows.length > 0 && (
<section class="home-releases" aria-labelledby="rel-h">
  <h2 id="rel-h">New releases</h2>
  <div class="rel-car" role="group" aria-roledescription="carousel" aria-label="New releases">
    <div class="rel-track" aria-live="off">
      {rows.map((r, i) => (
      <article class="rel rel-slide" id={`slide-${r.id}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${rows.length}: ${r.tab}`} data-name={r.tab} data-release={r.releaseDate} data-theme={r.theme} data-active={i === 0 ? '' : undefined}>
        {r.image ? (<picture>
          <source type="image/webp" srcset={srcset(r.image)} sizes={SLIDE} />
          <img src={r.image.jpg} width={r.image.width} height={r.image.height} alt="" loading="lazy" />
        </picture>) : (<div class="rel-art" aria-hidden="true"><span>One Piece</span></div>)}
        <div class="rel-body">
          <p class="rel-game">{r.short ?? r.game} · {r.name}</p>
          <h3>{r.ad ?? r.headline}</h3>
          {r.types && <p class="rel-name">{r.types}</p>}
          <p class="rel-date"><span data-status>{releaseLabel(r.releaseDate, today)}</span> · <span data-when>{dateLine(r.releaseDate, today)}</span></p>
          <p><a class="btn" href={holdHref(r.id)}>{r.cta ?? (<>Hold a {r.unit ?? 'box'} for me<span class="vh">, {r.name}</span></>)}</a></p>
          {r.credit && <p class="rel-credit">{r.credit}</p>}
        </div>
        {r.product && (<picture class="rel-product">
          <source type="image/webp" srcset={srcset(r.product)} sizes="7rem" />
          <img src={r.product.jpg} width={r.product.width} height={r.product.height} alt="" loading="lazy" />
        </picture>)}
      </article>))}
    </div>
    <div class="rel-ctl">
      <button type="button" class="btn btn-secondary rel-pp" data-state="pause">Pause</button>
      <button type="button" class="btn btn-secondary rel-prev" aria-label="Previous release"><span aria-hidden="true"></span></button>
      <span class="rel-pos">1 of {rows.length}</span>
      <button type="button" class="btn btn-secondary rel-next" aria-label="Next release"><span aria-hidden="true"></span></button>
      <ul class="rel-dots">
        {rows.map((r, i) => <li><button type="button" aria-label={`Show release ${i + 1}: ${r.tab}`} aria-current={i === 0 ? 'true' : undefined}></button></li>)}
      </ul>
      <p class="rel-note">Auto-play is off (your device setting)</p>
    </div>
  </div>
  <ul class="rel-grid">
    {rows.map((r) => { const p = r.image; return (
    <li class="rel" id={`rel-${r.id}`} data-release={r.releaseDate} data-theme={r.theme}>
      {p ? (<picture>
        <source type="image/webp" srcset={srcset(p)} sizes={GRID} />
        <img src={p.jpg} width={p.width} height={p.height} alt="" loading="lazy" />
      </picture>) : (<div class="rel-art" aria-hidden="true"><span>One Piece</span></div>)}
      <div class="rel-body">
        <p class="rel-game">{r.game}</p>
        <h3><a class="rel-link" href={holdHref(r.id)}>Hold a {r.unit ?? 'box'} for me<span class="vh">, {r.name}</span></a></h3>
        <p class="rel-name">{r.name}</p>
        <p class="rel-date" data-when>{dateLine(r.releaseDate, today)}</p>
        <span class="sticker" data-status>{releaseLabel(r.releaseDate, today)}</span>
        {r.credit && <p class="rel-credit">{r.credit}</p>}
      </div>
    </li>); })}
  </ul>
  <p class="rel-ask">Want a box or a deck? <a href="/visit/#contact">Ask us</a>.</p>
</section>
)}
