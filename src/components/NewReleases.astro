---
// New releases: official publisher images (CONTEXT rule 12), status computed at build and again in public/js/home-live.js (store zone).
import all from '../data/releases.json';
import store from '../data/store.json';
import { zoned } from '../lib/hours.js';
import { shownReleases, releaseLabel, dateLine, isOut } from '../lib/releases.js';

const today = zoned(store.timezone).date;
const rows = shownReleases(all.filter((r) => /^(Confirmed|Likely)/.test(r.certainty)), today);
const feat = rows.find((r) => r.id === 'mtg-star-trek') ?? rows[0];
const rest = rows.filter((r) => r !== feat);
const ask = ['Hold a box now', 'Preorder at the counter'];
const pic = (r, sizes, lazy) => {
  const { image: i } = r;
  return { srcset: i.webp.map(([u, w]) => `${u} ${w}w`).join(', '), sizes, loading: lazy ? 'lazy' : undefined, ...i };
};
---
{feat && (
<section class="home-releases" aria-labelledby="rel-h">
  <h2 id="rel-h">New releases</h2>
  {[feat].map((r) => { const p = pic(r, '100vw', false); return (
  <article class="rel rel-feat" data-release={r.releaseDate} data-theme={r.theme}>
    <picture>
      <source type="image/webp" srcset={p.srcset} />
      <img src={p.jpg} width={p.width} height={p.height} alt="" />
    </picture>
    <div class="rel-body">
      <p class="rel-game">{r.game} · {r.name}</p>
      <h3>New frontier. New cards.</h3>
      <p class="rel-date"><span data-status>{releaseLabel(r.releaseDate, today)}</span> · <span data-when>{dateLine(r.releaseDate, today)}</span></p>
      <p><a class="btn" href="/visit/#contact">Shop {r.name} in store</a></p>
      <p class="rel-credit">{r.credit}</p>
    </div>
  </article>); })}
  <ul class="rel-grid">
    {rest.map((r, n) => { const p = r.image && pic(r, '', true); return (
    <li class="rel" data-release={r.releaseDate} data-theme={r.theme}>
      {p ? (<picture>
        <source type="image/webp" srcset={p.webp[0][0]} />
        <img src={p.jpg} width={p.width} height={p.height} alt="" loading="lazy" />
      </picture>) : (<div class="rel-art" aria-hidden="true"></div>)}
      <div class="rel-body">
        <p class="rel-game">{r.game}</p>
        <h3><a class="rel-link" href="/visit/#contact"><span data-if="out" hidden={!isOut(r.releaseDate, today)}>Grab a pack</span><span data-if="soon" hidden={isOut(r.releaseDate, today)}>{ask[n % 2]}</span><span class="vh">, {r.name}</span></a></h3>
        <p class="rel-name">{r.name}</p>
        <p class="rel-date" data-when>{dateLine(r.releaseDate, today)}</p>
        <span class="sticker" data-status>{releaseLabel(r.releaseDate, today)}</span>
        {r.credit && <p class="rel-credit">{r.credit}</p>}
      </div>
    </li>); })}
  </ul>
</section>
)}
